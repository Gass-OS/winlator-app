<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="30dp"
        android:paddingBottom="28dp"
        android:background="?attr/preloaderBackground">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/winehub_brand_mark"
            android:contentDescription="WINE-HUB"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="WINE-HUB"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="?attr/colorPrimaryVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="WINDOWS ON ANDROID"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:textColor="?attr/colorSecondaryText" />

        <ProgressBar
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="24dp"
            android:indeterminate="true"
            android:indeterminateDrawable="?attr/progressBarIndeterminateImage" />

        <TextView
            android:id="@+id/TextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="?attr/colorPrimaryText" />

        <View
            android:layout_width="36dp"
            android:layout_height="3dp"
            android:layout_marginTop="20dp"
            android:background="#35D7FF" />
    </LinearLayout>
</FrameLayout>
